{
  "name": "cap2ui5-test",
  "private": true,
  "description": "The CAP project the test suite runs in: an ordinary CAP service (srv/catalog-service.cds, which knows nothing about cap2UI5), the fixture apps in srv/apps and the tests in test/. examples/bookshop is the example to read.",
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@cap2ui5/agent": "*",
    "@cap2ui5/cds-plugin": "*",
    "@sap/cds": "^10"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        },
        "client": {
          "timeout": 5000
        }
      }
    }
  },
  "scripts": {
    "start": "cds-serve",
    "test": "cds-deploy && node --test test/*.test.mjs",
    "test:browser": "cds-deploy && node --test test/browser.e2e.mjs",
    "cold-test": "node cold-test.mjs",
    "bench": "cds-deploy && node bench.mjs"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap2ui5/abap2js": "*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@sap/xssec": "^4",
    "playwright": "^1.63.0"
  }
}
