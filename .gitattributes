# Normalize line endings to LF for all text files: scripts/*.sh runs under
# `sh`, which a CRLF checkout breaks. The per-extension lines only force a
# type that auto-detection would already pick; the abap/xml/jsonc ones match
# nothing here today and are inert.
* text=auto eol=lf
*.abap text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
