{
  "name": "cap2ui5-workspace",
  "private": true,
  "description": "cap2UI5 - abap2UI5 as a CAP plugin. plugin/ is the npm package, examples/bookshop a project that uses it, runtime/ the @abap2ui5/runtime stand-in until upstream publishes it.",
  "workspaces": [
    "runtime",
    "plugin",
    "examples/bookshop"
  ],
  "scripts": {
    "start": "npm --workspace examples/bookshop start",
    "test": "npm --workspace examples/bookshop test",
    "test:browser": "npm --workspace examples/bookshop run test:browser",
    "cold-test": "npm --workspace examples/bookshop run cold-test",
    "bench": "npm --workspace examples/bookshop run bench",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^10"
  }
}
