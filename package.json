{
  "name": "cap2ui5-workspace",
  "private": true,
  "description": "cap2UI5 - abap2UI5 as a CAP plugin. plugin/ is the npm package, examples/bookshop a project that uses it, runtime/ the workspace stand-in for the published @abap2ui5/node-runtime.",
  "workspaces": [
    "runtime",
    "plugin",
    "examples/bookshop"
  ],
  "scripts": {
    "start": "npm --workspace examples/bookshop start",
    "test": "npm --workspace examples/bookshop test",
    "test:browser": "npm --workspace examples/bookshop run test:browser",
    "cold-test": "npm --workspace examples/bookshop run cold-test",
    "bench": "npm --workspace examples/bookshop run bench --",
    "consumer-test": "node scripts/consumer-test.mjs",
    "lint": "eslint .",
    "agent-vendor": "node scripts/vendor-agent.mjs",
    "agent-vendor:check": "node scripts/vendor-agent.mjs --check"
  },
  "devDependencies": {
    "eslint": "^10",
    "@sap/cds": "^10",
    "@abaplint/core": "^2.120.60"
  }
}
